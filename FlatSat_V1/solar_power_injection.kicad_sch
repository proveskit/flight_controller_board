	)
	(text "A Imax, Rmin 0.050 ohm, R1max 0.150 ohm, max time to trip 2.50 s at 8.00 A (Littelfuse 2920L Series datasheet, Electrical Characteristics table). This"
		(exclude_from_sim no)
		(at 20 200.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
