				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "87654b62-9406-4b93-a748-068ac1efb800")
	)
	(text "both the INA219 U8 26 V absolute maximum and the LT3652 32 V maximum. See sheet_solar_power_injection.md."
