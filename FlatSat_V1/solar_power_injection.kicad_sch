		(uuid "2b032b22-c6fb-4649-89a5-6bbd1ea91aa1")
	)
	(text "is the '1.85 A polyfuse' option of brief section 6.3; the '2 A slow-blow rated >=32 V' alternative is equally acceptable. Ihold is a 20 C ambient"
		(exclude_from_sim no)
		(at 20 202.67 0)
		(effects
